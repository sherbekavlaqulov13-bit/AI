<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙 OvozAI Yordamchi"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="100% Bepul, o'zbek tilida ovozli boshqaruv"
            android:textColor="@color/teal_accent"
            android:textSize="14sp" />

        <!-- ⚠️ Android 13/14 Restricted Settings Guide Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRestrictedSettingsNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#2D1A1A"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Ruxsatlar kulrang bo'lib qolganmi?"
                    android:textColor="#FF8A80"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Android 13/14 xavfsizlik tizimi internetdan olingan APK-larda ruxsatlarni vaqtincha cheklaydi («Controlled by restricted setting»).\n\nBuni yechish juda oson (1 marta qilinadi):\n1. Pastdagi qizil tugmani bosing (Ilova ma'lumoti ochiladi)\n2. Yuqori o'ng burchakdagi 3 ta nuqtani (⋮) bosing\n3. «Ruxsat berish» («Разрешить ограниченные настройки» / «Allow restricted settings») ni bosing\n4. So'ng qaytib bemalol ruxsatlarni yoqishingiz mumkin!"
                    android:textColor="#FFCDD2"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <Button
                    android:id="@+id/btnOpenAppDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#D32F2F"
                    android:text="🔓 Cheklovni yechish (Ilova ma'lumoti)"
                    android:textColor="@color/white"
                    android:textAllCaps="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 1. Boshqa ilovalar ustida ko'rsatish (Overlay) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Suzuvchi tugma (Boshqa ilovalar ustida ko'rsatish)"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Holati: Ruxsat berilmagan ❌"
                    android:textColor="@color/red_inactive"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Har qanday ilovada yoki ekranda turganda ovozli tugma doim ko'rinib turishi uchun zarur."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnGrantOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Suzuvchi tugmaga ruxsat berish"
                    android:textAllCaps="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. Xabarlarni o'qish (Notification Listener) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Xabarlarni o'qish (Telegram, WhatsApp, SMS)"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNotificationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Holati: Ruxsat berilmagan ❌"
                    android:textColor="@color/red_inactive"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Kelgan yangi xabarlarni ovozli o'qib berish va tezkor javob qaytarish uchun."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnGrantNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Xabarlarni o'qishga ruxsat berish"
                    android:textAllCaps="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. Qurilma ruxsatlari: Ovoz, Kamera/Fonar va Telefon qilish -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Mikrofon, Kamera/Fonar va Qo'ng'iroq"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDirectPermissionsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Holati: Ruxsat berilmagan ❌"
                    android:textColor="@color/red_inactive"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ovozingizni eshitish, fonarni yoqish, rasmga olish va telefon qilish uchun."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnGrantDirectPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Ruxsat berish"
                    android:textAllCaps="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Ishga Tushirish Tugmasi -->
        <Button
            android:id="@+id/btnToggleFloatingAssistant"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/green_active"
            android:text="🚀 Ovozli Yordamchini Ishga Tushirish"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Holat -->
        <TextView
            android:id="@+id/tvLiveLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/card_dark"
            android:padding="12dp"
            android:text="Kerakli ruxsatlarni berib, ishga tushirish tugmasini bosing."
            android:textColor="@color/teal_accent"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
